<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>강아지 도감 — 견종 알아보기</title>
<style>
  :root{
    --bg:#faf7f2;
    --card:#ffffff;
    --ink:#2b2420;
    --sub:#75695f;
    --line:#ece4da;
    --accent:#e07a3f;
    --accent-ink:#ffffff;
    --chip:#f4ede3;
    --shadow: 0 6px 20px rgba(60,40,20,0.08);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"Apple SD Gothic Neo","Pretendard","Noto Sans KR",-apple-system,BlinkMacSystemFont,sans-serif;
    line-height:1.5;
  }

  header{
    padding:56px 24px 32px;
    text-align:center;
    max-width:720px;
    margin:0 auto;
  }
  header .badge{
    display:inline-block;
    font-size:13px;
    font-weight:600;
    color:var(--accent);
    background:var(--chip);
    padding:6px 14px;
    border-radius:999px;
    margin-bottom:16px;
    letter-spacing:.02em;
  }
  header h1{
    font-size:clamp(28px,4vw,40px);
    margin:0 0 12px;
    font-weight:800;
    letter-spacing:-0.02em;
  }
  header p{
    color:var(--sub);
    font-size:16px;
    margin:0;
  }

  .controls{
    max-width:1080px;
    margin:0 auto;
    padding:0 24px 8px;
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
    justify-content:center;
  }
  .search{
    flex:1 1 260px;
    max-width:360px;
  }
  .search input{
    width:100%;
    padding:12px 16px;
    border-radius:12px;
    border:1px solid var(--line);
    background:var(--card);
    font-size:15px;
    color:var(--ink);
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .search input:focus{
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(224,122,63,0.15);
  }
  .filters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    justify-content:center;
  }
  .filters button{
    border:1px solid var(--line);
    background:var(--card);
    color:var(--sub);
    padding:10px 16px;
    border-radius:999px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    transition:all .15s ease;
  }
  .filters button:hover{
    border-color:var(--accent);
    color:var(--accent);
  }
  .filters button.active{
    background:var(--accent);
    border-color:var(--accent);
    color:var(--accent-ink);
  }

  .count{
    text-align:center;
    color:var(--sub);
    font-size:13px;
    margin:18px 0 4px;
  }

  .grid{
    max-width:1080px;
    margin:0 auto;
    padding:16px 24px 80px;
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
    gap:20px;
  }

  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:18px;
    overflow:hidden;
    box-shadow:var(--shadow);
    display:flex;
    flex-direction:column;
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .card:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 28px rgba(60,40,20,0.14);
  }
  .card .art{
    height:140px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:64px;
    position:relative;
  }
  .card .art .size-tag{
    position:absolute;
    top:10px;
    right:10px;
    font-size:11px;
    font-weight:700;
    background:rgba(255,255,255,.85);
    color:var(--ink);
    padding:4px 9px;
    border-radius:999px;
  }
  .card .body{
    padding:16px 18px 18px;
    flex:1;
    display:flex;
    flex-direction:column;
    gap:8px;
  }
  .card h3{
    margin:0;
    font-size:17px;
    font-weight:800;
  }
  .card .en{
    margin:-6px 0 0;
    font-size:12.5px;
    color:var(--sub);
    font-weight:500;
  }
  .card .meta{
    display:flex;
    gap:12px;
    font-size:12.5px;
    color:var(--sub);
    margin:2px 0 2px;
  }
  .card .desc{
    font-size:13.5px;
    color:var(--sub);
    margin:0;
    flex:1;
  }
  .card .tags{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:4px;
  }
  .card .tags span{
    font-size:11.5px;
    background:var(--chip);
    color:#8a5a2f;
    padding:4px 9px;
    border-radius:999px;
    font-weight:600;
  }

  .empty{
    text-align:center;
    color:var(--sub);
    padding:60px 20px;
    display:none;
  }

  /* modal */
  .overlay{
    position:fixed;
    inset:0;
    background:rgba(30,22,15,0.45);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:10;
  }
  .overlay.show{display:flex;}
  .modal{
    background:var(--card);
    border-radius:20px;
    max-width:440px;
    width:100%;
    max-height:88vh;
    overflow-y:auto;
    box-shadow:0 20px 60px rgba(0,0,0,0.25);
  }
  .modal .art{
    height:180px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:96px;
    border-radius:20px 20px 0 0;
  }
  .modal .content{
    padding:22px 26px 28px;
  }
  .modal h2{
    margin:0 0 2px;
    font-size:22px;
    font-weight:800;
  }
  .modal .en{
    color:var(--sub);
    font-size:13px;
    margin:0 0 14px;
  }
  .modal table{
    width:100%;
    border-collapse:collapse;
    margin-bottom:14px;
  }
  .modal table td{
    padding:8px 0;
    border-bottom:1px solid var(--line);
    font-size:13.5px;
  }
  .modal table td:first-child{
    color:var(--sub);
    width:80px;
  }
  .modal .tags{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:14px;
  }
  .modal .tags span{
    font-size:12px;
    background:var(--chip);
    color:#8a5a2f;
    padding:5px 10px;
    border-radius:999px;
    font-weight:600;
  }
  .modal p.desc{
    font-size:14.5px;
    color:var(--ink);
    line-height:1.65;
    margin:0 0 18px;
  }
  .modal .close{
    display:block;
    width:100%;
    padding:12px;
    background:var(--chip);
    border:none;
    border-radius:12px;
    color:var(--ink);
    font-weight:700;
    font-size:14px;
    cursor:pointer;
  }
  .modal .close:hover{ background:var(--line); }

  footer{
    text-align:center;
    color:var(--sub);
    font-size:12.5px;
    padding:0 20px 40px;
  }
</style>
</head>
<body>

<header>
  <span class="badge">🐾 DOG BREED GUIDE</span>
  <h1>강아지 도감</h1>
  <p>크기와 성격으로 견종을 살펴보고, 나에게 맞는 강아지를 찾아보세요.</p>
</header>

<div class="controls">
  <div class="search">
    <input type="text" id="searchInput" placeholder="견종 이름 검색 (예: 진돗개, 푸들...)">
  </div>
  <div class="filters" id="filters">
    <button data-filter="전체" class="active">전체</button>
    <button data-filter="소형견">소형견</button>
    <button data-filter="중형견">중형견</button>
    <button data-filter="대형견">대형견</button>
  </div>
</div>

<p class="count" id="count"></p>

<div class="grid" id="grid"></div>
<p class="empty" id="empty">검색 결과가 없어요 🐕</p>

<footer>정보는 일반적인 견종 특성을 요약한 것으로, 개체별 차이가 있을 수 있습니다.</footer>

<div class="overlay" id="overlay">
  <div class="modal" id="modal"></div>
</div>

<script>
const breeds = [
  {
    name:"진돗개", en:"Jindo", emoji:"🐕", size:"중형견",
    weight:"15~23kg", height:"48~53cm", life:"12~15년",
    tags:["충성심","영리함","경계심"], color:"#f3e3cf",
    desc:"한국 천연기념물로 지정된 견종. 주인에 대한 충성심이 매우 강하고 영리하지만, 낯선 사람과 동물을 경계하는 편이라 어릴 때부터 사회화 훈련이 중요합니다."
  },
  {
    name:"골든 리트리버", en:"Golden Retriever", emoji:"🦮", size:"대형견",
    weight:"25~34kg", height:"51~61cm", life:"10~12년",
    tags:["온순함","친화력","가족견"], color:"#fbe8c8",
    desc:"세상에서 가장 순하고 다정한 견종 중 하나로 꼽힙니다. 아이들과도 잘 지내고 사람을 매우 좋아해 반려견 입문 견종으로 인기가 높습니다."
  },
  {
    name:"래브라도 리트리버", en:"Labrador Retriever", emoji:"🐕‍🦺", size:"대형견",
    weight:"25~36kg", height:"55~62cm", life:"10~12년",
    tags:["활발함","똑똑함","다재다능"], color:"#eee1cf",
    desc:"안내견, 탐지견으로도 활약할 만큼 똑똑하고 훈련이 잘 되는 견종. 에너지가 넘쳐 충분한 산책과 운동이 필요합니다."
  },
  {
    name:"시베리안 허스키", en:"Siberian Husky", emoji:"🐺", size:"대형견",
    weight:"16~27kg", height:"51~60cm", life:"12~14년",
    tags:["체력왕","독립적","탈출주의"], color:"#e6eef2",
    desc:"눈밭을 달리던 썰매견답게 지구력이 뛰어나고 활동량이 많습니다. 독립적인 성격이라 고집이 세게 느껴질 수 있어요."
  },
  {
    name:"보더 콜리", en:"Border Collie", emoji:"🐕", size:"중형견",
    weight:"14~20kg", height:"46~56cm", life:"12~15년",
    tags:["최고 지능견","양치기","운동량 많음"], color:"#e2e6dc",
    desc:"견종 중 지능이 가장 뛰어나다고 알려져 있으며 양몰이 본능이 강합니다. 두뇌 자극과 운동이 부족하면 스트레스를 받기 쉬워요."
  },
  {
    name:"웰시 코기", en:"Welsh Corgi", emoji:"🦴", size:"중형견",
    weight:"10~14kg", height:"25~30cm", life:"12~13년",
    tags:["짧은다리","영리함","활발함"], color:"#f6e9d2",
    desc:"짧은 다리와 통통한 엉덩이가 매력 포인트. 원래 목축견 출신이라 몸집에 비해 활동적이고 짖음이 있는 편입니다."
  },
  {
    name:"푸들", en:"Poodle", emoji:"🐩", size:"소형견",
    weight:"3~7kg (토이 기준)", height:"24~28cm", life:"12~15년",
    tags:["털빠짐 적음","똑똑함","애교"], color:"#f1e8f2",
    desc:"곱슬거리는 털로 유명하며 지능이 매우 높은 견종입니다. 털이 잘 빠지지 않아 알레르기가 있는 가정에서도 인기가 많습니다."
  },
  {
    name:"비숑 프리제", en:"Bichon Frise", emoji:"☁️", size:"소형견",
    weight:"3~5kg", height:"23~30cm", life:"14~15년",
    tags:["솜사탕 외모","쾌활함","사교적"], color:"#f5f5f0",
    desc:"하얗고 풍성한 털이 솜사탕을 닮았습니다. 사람을 좋아하고 명랑해서 함께 있으면 즐거운 견종이에요."
  },
  {
    name:"말티즈", en:"Maltese", emoji:"🐇", size:"소형견",
    weight:"2~4kg", height:"20~25cm", life:"12~15년",
    tags:["애교만점","순함","실내견"], color:"#f2f2ec",
    desc:"우리나라에서 가장 사랑받는 반려견 중 하나. 사람을 잘 따르고 애교가 많아 1인 가구에서도 많이 키웁니다."
  },
  {
    name:"포메라니안", en:"Pomeranian", emoji:"🦊", size:"소형견",
    weight:"1.9~3.5kg", height:"18~30cm", life:"12~16년",
    tags:["풍성한 털","호기심","기 세짐"], color:"#f8e3cf",
    desc:"여우를 닮은 얼굴과 풍성한 털이 특징. 몸집은 작지만 자신감 넘치고 목소리가 큰 편입니다."
  },
  {
    name:"치와와", en:"Chihuahua", emoji:"🐁", size:"소형견",
    weight:"1.5~3kg", height:"15~23cm", life:"14~16년",
    tags:["세계最小견","용감함","애착 강함"], color:"#efe4d8",
    desc:"세상에서 가장 작은 견종 중 하나지만 성격은 매우 당차고 용감합니다. 주인에게 강한 애착을 보여요."
  },
  {
    name:"닥스훈트", en:"Dachshund", emoji:"🌭", size:"소형견",
    weight:"7~15kg", height:"13~25cm", life:"12~16년",
    tags:["긴 허리","용맹함","호기심"], color:"#f4e6ce",
    desc:"소시지를 닮은 긴 몸통이 특징적인 견종. 원래 오소리 사냥용으로 개량되어 겁이 없고 고집이 있는 편입니다."
  },
  {
    name:"비글", en:"Beagle", emoji:"🐶", size:"중형견",
    weight:"9~11kg", height:"33~41cm", life:"12~15년",
    tags:["후각 천재","친근함","식탐"], color:"#efe0cf",
    desc:"뛰어난 후각으로 탐지견으로도 활약하는 견종. 사람과 다른 동물 모두에게 우호적이고 식욕이 왕성합니다."
  },
  {
    name:"불도그", en:"Bulldog", emoji:"🐾", size:"중형견",
    weight:"18~25kg", height:"31~40cm", life:"8~10년",
    tags:["느긋함","고집","더위 약함"], color:"#e8dfd6",
    desc:"주름진 얼굴과 다부진 체형이 매력적. 성격은 의외로 온순하고 느긋하지만, 코가 짧아 더위에 약하니 주의가 필요합니다."
  },
  {
    name:"사모예드", en:"Samoyed", emoji:"🐻‍❄️", size:"대형견",
    weight:"16~30kg", height:"46~56cm", life:"12~14년",
    tags:["미소천사","친화력","풍성한 털"], color:"#eef2f5",
    desc:"입꼬리가 올라가 항상 웃는 것처럼 보이는 '스마일 독'. 사람을 매우 좋아하고 온순한 대형견입니다."
  },
  {
    name:"그레이트 데인", en:"Great Dane", emoji:"🐕‍🦺", size:"대형견",
    weight:"50~90kg", height:"71~86cm", life:"7~10년",
    tags:["초대형","순둥이","젠틀 자이언트"], color:"#e4d9cc",
    desc:"세계에서 가장 키가 큰 견종 중 하나로 '젠틀 자이언트'라 불립니다. 덩치와 달리 성격은 매우 온순하고 다정해요."
  }
];

const grid = document.getElementById('grid');
const empty = document.getElementById('empty');
const count = document.getElementById('count');
const searchInput = document.getElementById('searchInput');
const filterBtns = document.querySelectorAll('#filters button');
const overlay = document.getElementById('overlay');
const modal = document.getElementById('modal');

let activeFilter = '전체';

function render(){
  const q = searchInput.value.trim().toLowerCase();
  const filtered = breeds.filter(b=>{
    const matchFilter = activeFilter === '전체' || b.size === activeFilter;
    const matchQuery = !q || b.name.toLowerCase().includes(q) || b.en.toLowerCase().includes(q);
    return matchFilter && matchQuery;
  });

  grid.innerHTML = filtered.map((b,i)=>`
    <div class="card" data-index="${breeds.indexOf(b)}">
      <div class="art" style="background:${b.color}">
        <span class="size-tag">${b.size}</span>
        ${b.emoji}
      </div>
      <div class="body">
        <h3>${b.name}</h3>
        <p class="en">${b.en}</p>
        <div class="meta">
          <span>⚖️ ${b.weight}</span>
        </div>
        <p class="desc">${b.desc}</p>
        <div class="tags">${b.tags.map(t=>`<span>#${t}</span>`).join('')}</div>
      </div>
    </div>
  `).join('');

  empty.style.display = filtered.length ? 'none' : 'block';
  count.textContent = `총 ${filtered.length}개 견종`;

  grid.querySelectorAll('.card').forEach(card=>{
    card.addEventListener('click', ()=>openModal(breeds[card.dataset.index]));
  });
}

function openModal(b){
  modal.innerHTML = `
    <div class="art" style="background:${b.color}">${b.emoji}</div>
    <div class="content">
      <h2>${b.name}</h2>
      <p class="en">${b.en}</p>
      <div class="tags">${b.tags.map(t=>`<span>#${t}</span>`).join('')}</div>
      <table>
        <tr><td>크기</td><td>${b.size}</td></tr>
        <tr><td>체중</td><td>${b.weight}</td></tr>
        <tr><td>체고</td><td>${b.height}</td></tr>
        <tr><td>기대수명</td><td>${b.life}</td></tr>
      </table>
      <p class="desc">${b.desc}</p>
      <button class="close" id="closeBtn">닫기</button>
    </div>
  `;
  overlay.classList.add('show');
  document.getElementById('closeBtn').addEventListener('click', closeModal);
}
function closeModal(){ overlay.classList.remove('show'); }
overlay.addEventListener('click', e=>{ if(e.target === overlay) closeModal(); });
document.addEventListener('keydown', e=>{ if(e.key === 'Escape') closeModal(); });

filterBtns.forEach(btn=>{
  btn.addEventListener('click', ()=>{
    filterBtns.forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    activeFilter = btn.dataset.filter;
    render();
  });
});
searchInput.addEventListener('input', render);

render();
</script>

</body>
</html>
